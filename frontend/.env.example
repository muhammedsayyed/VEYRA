# Veyra Wellness AI Environment Configuration

# ----------------------------------------------------
# 1. DATABASE (server-side only - never expose to the browser)
# PostgreSQL connection string. Prisma schema: prisma/schema.prisma
# Apply with `npx prisma db push`; seed food data with `npm run seed:food`.
# ----------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared session secret for signing auth session tokens (server-side only).
AUTH_SECRET=change_me_to_a_long_random_string

# ----------------------------------------------------
# 2. PRODUCTION CLOUD AI (Vercel Deployment / OpenRouter)
# Configure these in Vercel Dashboard -> Environment Variables.
# The API key is a server-side secret; it is never sent to the client.
# ----------------------------------------------------
VEYRA_AI_PROVIDER=cloud
VEYRA_AI_CLOUD_BASE_URL=https://openrouter.ai/api/v1
VEYRA_AI_CLOUD_MODEL=nvidia/nemotron-3.5-lightning:free
VEYRA_AI_CLOUD_API_KEY=sk-or-v1-your-cloud-api-key-here

# ----------------------------------------------------
# 3. LOCAL DEVELOPMENT AI (Local Ollama - optional alternative to cloud)
# ----------------------------------------------------
# VEYRA_AI_PROVIDER=ollama
# VEYRA_AI_BASE_URL=http://localhost:11434/v1
# VEYRA_AI_MODEL=qwen2.5:3b

# ----------------------------------------------------
# 4. MONGODB EXPRESS BACKEND (new separated backend in /backend)
# ----------------------------------------------------
# MongoDB connection for Express backend (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/veyra
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/veyra?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=30d
PORT=5000
CLIENT_URL=http://localhost:8443

# ----------------------------------------------------
# 5. PUBLIC (browser-exposed) VARIABLES - VITE_ prefix only
# ----------------------------------------------------
# New Express backend URL (set to http://localhost:5000/api for local Mongo backend, leave empty to use Vercel Postgres backend)
VITE_API_URL=http://localhost:5000/api
# Frontend endpoint override for the AI chat backend.
VITE_VEYRA_AI_ENDPOINT=/api/ai/chat
# Optional override for the external meal/product API base URL.
# VITE_MEAL_API_URL=https://nutriplan-api.vercel.app/api
# Optional API key used by the dev proxy for the external nutrition API.
# VITE_NUTRITION_API_KEY=your_external_api_key_here
