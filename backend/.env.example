PORT=5000
MONGODB_URI=mongodb://localhost:27017/veyra
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/veyra?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:8443
NODE_ENV=development
# AI Provider (server-side only, never expose to frontend) - REQUIRED for /api/ai/chat
VEYRA_AI_CLOUD_API_KEY=sk-or-v1-your-openrouter-key-here
VEYRA_AI_CLOUD_BASE_URL=https://openrouter.ai/api/v1
VEYRA_AI_CLOUD_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
