        {
          "name": "Analyze recipe nutrition",
          "id": "e711a3c9-42d2-498a-91d0-5cee18868f7d",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "YOUR_USDA_API_KEY",
                "description": "<p>Your USDA API key (required)</p>\n",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"recipeName\": \"Baked salmon with fennel & tomatoes\",\r\n    \"ingredients\": [\r\n        \"2 medium Fennel\",\r\n        \"2 tbs chopped Parsley\",\r\n        \"Juice of 1 Lemon\",\r\n        \"175g Cherry Tomatoes\",\r\n        \"1 tbs Olive Oil\",\r\n        \"350g Salmon\",\r\n        \"to serve Black Olives\"\r\n    ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://nutriplan-api.vercel.app/api/nutrition/analyze",
            "description": "<p>Search USDA food database for nutrition information</p>\n",
            "urlObject": {
              "path": [
                "nutrition",
                "analyze"
              ],
              "host": [
                "https://nutriplan-api.vercel.app/api"
              ],
              "query": [],
              "variable": []
            }
          },
          "response": [],
          "_postman_id": "e711a3c9-42d2-498a-91d0-5cee18868f7d"
